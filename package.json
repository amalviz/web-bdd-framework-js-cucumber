{
  "name": "web-bdd-framework-js-cucumber",
  "version": "1.0.0",
  "description": "BDD test automation framework with JavaScript, Selenium WebDriver, and Cucumber",
  "type": "module",
  "scripts": {
    "test": "cucumber-js",
    "test:web": "cucumber-js --tags '@web'",
    "test:api": "cucumber-js --tags '@api'",
    "test:headed": "HEADLESS=false cucumber-js",
    "test:report": "cucumber-js --format html:reports/cucumber-report.html",
    "test:retry": "SCENARIO_RETRY_COUNT=2 cucumber-js"
  },
  "keywords": [
    "cucumber",
    "selenium",
    "bdd",
    "automation"
  ],
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "chai": "^5.2.0",
    "dotenv": "^16.4.7",
    "selenium-webdriver": "^4.28.1"
  },
  "dependencies": {
    "axios": "^1.8.4"
  }
}
