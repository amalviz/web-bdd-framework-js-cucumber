# Browser
BROWSER=chrome
HEADLESS=true
IMPLICIT_WAIT_MS=10000
PAGE_LOAD_TIMEOUT_MS=30000

# Application URLs
BASE_URL=https://the-internet.herokuapp.com
API_BASE_URL=https://jsonplaceholder.typicode.com

# Login credentials (do not commit real secrets; .env is gitignored)
LOGIN_USERNAME=tomsmith
LOGIN_PASSWORD=SuperSecretPassword!

# Retry
SCENARIO_RETRY_COUNT=0
SCENARIO_RETRY_TAG_FILTER=
ACTION_RETRY_COUNT=3
ACTION_RETRY_DELAY_MS=500
